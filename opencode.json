{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "atlassian_*": "deny",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rmdir *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "mv *": "ask",
      "dd *": "deny",
      "mkfs*": "deny",
      "sudo *": "ask",
      "> /dev/*": "deny"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "atlassian": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "oauth": {}
    },
    "zabbix": {
      "enabled": false,
      "type": "local",
      "command": [
        "podman",
        "run",
        "-i",
        "--rm",
        "--log-driver=none",
        "-e", "ZABBIX_MCP_TRANSPORT=stdio",
        "-e", "ZABBIX_URL",
        "-e", "ZABBIX_TOKEN",
        "-e", "VERIFY_SSL",
        "localhost/zabbix-mcp-server"
      ],
      "environment": {
        "ZABBIX_URL": "https://zabbix3prod.sofico.be/zabbix/",
        "ZABBIX_TOKEN": "{file:HOME/.local/secrets/zabbix_token}",
        "VERIFY_SSL": "false"
      }
    },
    "elk": {
      "enabled": false,
      "type": "local",
      "command": [
        "podman",
        "run",
        "-i",
        "--rm",
        "--network=host",
        "--log-driver=none",
        "-e", "ES_URL",
        "-e", "ES_API_KEY",
        "-e", "ES_SSL_SKIP_VERIFY",
        "docker.elastic.co/mcp/elasticsearch",
        "stdio"
      ],
      "environment": {
        "ES_URL": "https://127.0.0.1:9200",
        "ES_API_KEY": "{file:HOME/.local/secrets/elk_token}",
        "ES_SSL_SKIP_VERIFY": "true"
      }
    },
    "foreman": {
      "enabled": false,
      "type": "local",
      "command": [
        "podman",
        "run",
        "-i",
        "--rm",
        "--log-driver=none",
        "-e", "FOREMAN_USERNAME",
        "-e", "FOREMAN_PASSWORD",
        "quay.io/foreman/foreman-mcp-server:latest",
        "--transport", "stdio",
        "--foreman-url", "https://ssbforeman.sofico.be/",
        "--no-verify-ssl"
      ],
      "environment": {
        "FOREMAN_USERNAME": "{file:HOME/.local/secrets/foreman_username}",
        "FOREMAN_PASSWORD": "{file:HOME/.local/secrets/foreman_token}"
      }
    }
  }
}
