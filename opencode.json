{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "atlassian_*": "deny",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rmdir *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "mv *": "ask",
      "dd *": "deny",
      "mkfs*": "deny",
      "sudo *": "ask",
      "> /dev/*": "deny"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "atlassian": {
      "enabled": false,
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "oauth": {}
    },
    "zabbix": {
      "enabled": false,
      "type": "local",
      "command": [
        "podman",
        "run",
        "-i",
        "--rm",
        "--log-driver=none",
        "-e", "ZABBIX_MCP_TRANSPORT=stdio",
        "-e", "ZABBIX_URL",
        "-e", "ZABBIX_TOKEN",
        "-e", "VERIFY_SSL",
        "localhost/zabbix-mcp-server"
      ],
      "environment": {
        "ZABBIX_URL": "{file:SECRETSDIR/zabbix_url}",
        "ZABBIX_TOKEN": "{file:SECRETSDIR/zabbix_token}",
        "VERIFY_SSL": "false"
      }
    },
    "elk": {
      "enabled": false,
      "type": "local",
      "command": [
        "podman",
        "run",
        "-i",
        "--rm",
        "--network=host",
        "--log-driver=none",
        "-e", "ES_URL",
        "-e", "ES_API_KEY",
        "-e", "ES_SSL_SKIP_VERIFY",
        "docker.elastic.co/mcp/elasticsearch",
        "stdio"
      ],
      "environment": {
        "ES_URL": "{file:SECRETSDIR/elk_url}",
        "ES_API_KEY": "{file:SECRETSDIR/elk_token}",
        "ES_SSL_SKIP_VERIFY": "true"
      }
    },
    "foreman": {
      "enabled": false,
      "type": "local",
      "command": [
        "podman",
        "run",
        "-i",
        "--rm",
        "--log-driver=none",
        "-e", "FOREMAN_USERNAME",
        "-e", "FOREMAN_PASSWORD",
        "-e", "FOREMAN_URL",
        "quay.io/foreman/foreman-mcp-server:latest",
        "--transport", "stdio",
        "--no-verify-ssl"
      ],
      "environment": {
        "FOREMAN_USERNAME": "{file:SECRETSDIR/foreman_username}",
        "FOREMAN_PASSWORD": "{file:SECRETSDIR/foreman_token}",
        "FOREMAN_URL": "{file:SECRETSDIR/foreman_url}"
      }
    },
    "fortimanager": {
      "enabled": false,
      "type": "local",
      "command": [
        "podman",
        "run",
        "-i",
        "--rm",
        "--log-driver=none",
        "-e", "FORTIMANAGER_HOST",
        "-e", "FORTIMANAGER_API_TOKEN",
        "-e", "FORTIMANAGER_VERIFY_SSL",
        "-e", "MCP_SERVER_MODE",
        "-e", "FMG_TOOL_MODE",
        "ghcr.io/rstierli/fortimanager-mcp:latest"
      ],
      "environment": {
        "FORTIMANAGER_HOST": "{file:SECRETSDIR/fortimanager_host}",
        "FORTIMANAGER_API_TOKEN": "{file:SECRETSDIR/fortimanager_token}",
        "FORTIMANAGER_VERIFY_SSL": "false",
        "MCP_SERVER_MODE": "stdio",
        "FMG_TOOL_MODE": "dynamic"
      }
    }
  }
}
